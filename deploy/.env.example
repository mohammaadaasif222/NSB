# Domain Caddy serves. A real domain gets automatic HTTPS, e.g. staging.noidasuperbazaar.com
# Use ":80" to serve plain http on the server IP before DNS is ready (then set COOKIE_SECURE=false).
SITE_ADDRESS=staging.noidasuperbazaar.com

POSTGRES_PASSWORD=change-me
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_DAYS=7
COOKIE_SECURE=true

# First admin login, created by: docker compose exec api node dist/db/seed.js
SEED_ADMIN_EMAIL=admin@noidasuperbazaar.com
SEED_ADMIN_PASSWORD=change-me-please

# Public address, used for links in enquiry alert emails. SMTP itself is set in Admin > Settings.
SITE_URL=https://staging.noidasuperbazaar.com

# Image uploads. Choose Cloudinary, Firebase Storage or this server, and enter their
# credentials, in Admin > Settings.
UPLOAD_MAX_MB=5
# Encrypts the credentials saved there (and the SMTP password). Optional (falls back to JWT_SECRET); keep it stable.
SETTINGS_ENCRYPTION_KEY=
# Optional fallback Cloudinary credentials, used only when none are saved in Admin > Settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nsb
