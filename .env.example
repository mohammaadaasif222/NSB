# ROLLUCK player app env. Copy to .env for local dev.
# NOTE: every NEXT_PUBLIC_* var is baked into the build and shipped to the browser —
# do not store real secrets here.

# Backend API base URL.
#   local:  http://localhost:5000/api
#   render: https://rolluck-backend.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Shared password-obfuscation secret — must match the backend's PASSWORD_SECRET.
NEXT_PUBLIC_PASSWORD_SECRET=rolluck-shared-password-secret

HUSKY_ENABLED=true

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Analytics. Each tool loads only when its id is set, so leaving these empty —
# which is the right thing to do locally — means nothing is collected and
# neither script is fetched.
#
# GA4 Measurement ID from the property's web data stream ("G-XXXXXXXXXX").
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project id, from the project's setup page.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Set to "true" to log every event to the browser console while testing.
NEXT_PUBLIC_ANALYTICS_DEBUG=

# Telegram bot's numeric id (not the token, not the @username) — safe to
# expose. The site's domain must also be registered on the bot via
# @BotFather -> /setdomain.
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# Intercom: nothing to set here.
#
# The App ID is served at runtime by the API (GET /intercom/settings) rather
# than baked into this bundle, so an operator can switch live chat on from
# System config without a frontend rebuild. Set INTERCOM_APP_ID on the API.
