# All optional in development: copy to apps/web/.env only to change them.

# Where server components and the /api rewrite reach the API.
API_INTERNAL_URL=http://localhost:4000/api

# Public site address, for canonical URLs, robots.txt and the sitemap. Falls back to the production domain.
SITE_URL=http://localhost:3000

# The public site's address, for links from the admin once it runs on its own domain.
# Leave blank while they share one. Read at build time.
NEXT_PUBLIC_SITE_URL=

# GA4 measurement ID. Public and compiled into the web app at build time.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-M038E5ZW18
