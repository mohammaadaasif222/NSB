NODE_ENV=development
PORT=4000
# Dev Postgres from the root docker-compose.yml (host port 5434)
DATABASE_URL=postgres://nsb:nsb@localhost:5434/nsb
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_DAYS=7
# false only for local http; keep true behind https
COOKIE_SECURE=false

# Public site address, used for links in enquiry alert emails (optional).
SITE_URL=http://localhost:3000

# Encrypts credentials saved in Admin > Settings (Cloudinary secret, Firebase key, SMTP password).
# Optional: falls back to JWT_SECRET. Changing it means re-entering those credentials.
SETTINGS_ENCRYPTION_KEY=

# Image uploads. The provider (Cloudinary, Firebase Storage or local) and the Cloudinary and
# Firebase credentials are set in Admin > Settings.
# Local files are written to UPLOAD_DIR (relative to apps/api) and served at /api/uploads/.
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# Optional fallback Cloudinary credentials, used only when none are saved in Admin > Settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nsb

# Used by `npm run db:seed` to create the first admin login
SEED_ADMIN_EMAIL=admin@noidasuperbazaar.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=NSB Admin
